# ---------------------------------------------------------------------------
# RoadGuard AI configuration (copy to .env and edit)
# ---------------------------------------------------------------------------
ROADGUARD_ENVIRONMENT=development
ROADGUARD_DEBUG=false

# --- persistence -----------------------------------------------------------
# SQLite (default). For PostgreSQL use:
# ROADGUARD_DATABASE_URL=postgresql+psycopg://roadguard:password@localhost:5432/roadguard
ROADGUARD_DATABASE_URL=sqlite:///./data/roadguard.db
ROADGUARD_STORAGE_DIR=./data/uploads

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROADGUARD_JWT_SECRET=replace-with-a-long-random-secret
ROADGUARD_ACCESS_TOKEN_EXPIRE_MINUTES=720
ROADGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROADGUARD_CORS_ALLOW_ORIGIN_REGEX=https://.*\.e2b\.app
ROADGUARD_MAX_UPLOAD_MB=10
ROADGUARD_RATE_LIMIT_WINDOW_SECONDS=60
ROADGUARD_RATE_LIMIT_DETECTION_PER_WINDOW=30
ROADGUARD_RATE_LIMIT_AUTH_PER_WINDOW=20

# --- detection -------------------------------------------------------------
ROADGUARD_MODEL_PATH=./data/models/pothole_yolov8.pt
ROADGUARD_MODEL_NAME=RoadGuard road-distress YOLOv8s
ROADGUARD_MODEL_VERSION=pothole-yolov8s-community-v1
ROADGUARD_CONF_THRESHOLD=0.35
ROADGUARD_IOU_THRESHOLD=0.45
ROADGUARD_MAX_DETECTIONS=100
ROADGUARD_DEVICE=cpu

# --- map / demo data -------------------------------------------------------
ROADGUARD_DEFAULT_MAP_LAT=23.0225
ROADGUARD_DEFAULT_MAP_LNG=72.5714
ROADGUARD_DEFAULT_MAP_ZOOM=12
ROADGUARD_DEMO_REGION_LABEL=Ahmedabad, Gujarat (demo region)
ROADGUARD_SEED_DEMO_ON_STARTUP=true
ROADGUARD_DEMO_REPORT_COUNT=120

# --- prioritisation --------------------------------------------------------
ROADGUARD_PRIORITY_AGE_FULL_DAYS=30
ROADGUARD_PRIORITY_REPEAT_RADIUS_M=250
ROADGUARD_PRIORITY_REPEAT_WINDOW_DAYS=60
ROADGUARD_DUPLICATE_RADIUS_M=120
ROADGUARD_DUPLICATE_WINDOW_DAYS=14
